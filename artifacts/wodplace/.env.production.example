# Production values for wodplace.cl -- NOT loaded automatically by Expo
# (only .env.local is). Use these when configuring an EAS build profile
# (eas.json) or when switching your own .env.local to test against the
# deployed backend instead of your machine's LAN IP.
#
# No code change is needed to switch between local/LAN and production --
# see lib/apiConfig.ts / lib/dashboardUrl.ts, which just read these env
# vars with no hardcoded fallback.

EXPO_PUBLIC_API_URL=https://api.wodplace.cl
EXPO_PUBLIC_DASHBOARD_URL=https://admin.wodplace.cl
EXPO_PUBLIC_SUPERADMIN_URL=https://super.wodplace.cl

# Same Supabase project as local dev -- these are not secret (the
# publishable key is safe to ship client-side by design).
EXPO_PUBLIC_SUPABASE_URL=https://wiwpaekdykxernegicdv.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_8-je3HYCO8p0-uINr20d3w_VINNhkyq
