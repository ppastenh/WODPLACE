# Copy to .env for local dev (node --env-file=.env). In Render, load each
# of these as a separate environment variable in the dashboard -- the
# "start" script does NOT read a .env file.

# Port the server listens on. Render sets this for you automatically; only
# needed explicitly for local dev (dev:local).
PORT=5000

# development | production -- affects logging and, in production, REQUIRES
# ALLOWED_ORIGINS to be set (see cors.ts).
NODE_ENV=development

# pino log level: trace | debug | info | warn | error | fatal. Optional,
# defaults to pino's own default (info) if unset.
LOG_LEVEL=info

# Comma-separated list of browser origins allowed to call this API (CORS).
# Required in production. Native app requests (wodplace itself) are never
# subject to CORS and don't need to be listed here.
#   Local dev example:      http://localhost:5002,http://localhost:5003
#   Production example:     https://admin.wodplace.cl,https://super.wodplace.cl
ALLOWED_ORIGINS=http://localhost:5002,http://localhost:5003

# Postgres connection string (direct, bypasses RLS -- connects as the
# `postgres` role). Get this from Supabase: Project Settings -> Database.
DATABASE_URL=

# Supabase project URL and SERVICE ROLE key (bypasses RLS -- never expose
# this client-side, never commit it). Project Settings -> API.
SUPABASE_URL=https://wiwpaekdykxernegicdv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name for uploads. Defaults to "wodplace-uploads" if unset.
SUPABASE_STORAGE_BUCKET=wodplace-uploads

# Box-admin and super-admin's own deployed origins -- used ONLY to build
# the redirect URL for the admin magic-link auto-login flow.
#   Local dev example:      http://localhost:5002 / http://localhost:5003
#   Production example:     https://admin.wodplace.cl / https://super.wodplace.cl
DASHBOARD_URL=http://localhost:5002
SUPERADMIN_URL=http://localhost:5003

# Signing secret for admin session tokens. Any value works for local dev;
# use a real secret in prod.
ADMIN_ACCESS_CODE=

# Email address that receives internal owner notifications.
OWNER_EMAIL=
